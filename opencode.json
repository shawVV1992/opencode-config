{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx.cmd",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx.cmd",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "timeout": 60000,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "pencil": {
      "command": [
        "{env:PENCIL_MCP_PATH}",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "provider": {
    "bailian": {
      "models": {
        "qwen3.7-max": {
          "name": "qwen3.7-max",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "qwen3.7-plus": {
          "name": "qwen3.7-plus",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      },
      "name": "Bailian",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:BAILIAN_API_KEY}",
        "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "setCacheKey": true
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com/v1",
        "setCacheKey": true
      }
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context@latest"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "instructions": [
    "instructions/language.md",
    "instructions/glossary.md"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}
